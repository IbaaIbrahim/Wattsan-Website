{
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"esModuleInterop": true,
		"noImplicitAny": false,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": [
				"./src/app/*"
			],
			"@public/*": [
				"./public/*"
			],
			"@components/*": [
				"./src/components/*"
			],
			"@constants/*": [
				"./src/constants/*"
			],
			"@my-types/*": [
				"./src/types/*"
			],
			"@hooks/*": [
				"./src/hooks/*"
			],
			"@store/*": [
				"./src/store/*"
			],
			"@services/*": [
				"./src/services/*"
			],
			"@api/*": [
				"./src/api/*"
			]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}